{
 "version": 1,
 "about": "Hob-speak barks and their subtitles. The sound is gibberish; the subtitle is the line. Pick a subtitle at random with no repeats. Keys under hobs are content Hob ids. The sound ids for old_thumper still start bark_thumper_.",
 "rules": {
  "gap_s": 1.5,
  "per_side_per_turn_step": 1,
  "subtitle_show_s": "1.5 + 0.06 per letter, at least 2",
  "line_rules": "Seven words at most. One trade line in three at most. One exclamation mark per Hob per event at most. Counts are uneven on purpose."
 },
 "events": {
  "picked": {
   "trigger": "Command pick_hob, your Hob",
   "anim": "hob_<id>_<side>_aim (start)",
   "chance": 0.4
  },
  "fire": {
   "trigger": "Core event fire, the shooter",
   "anim": "hob_<id>_<side>_fire:release",
   "chance": 0.4
  },
  "hit_lands": {
   "trigger": "Core event hit, target hob: the shooter barks",
   "anim": "hob_<id>_<side>_cheer:jump",
   "chance": 0.4
  },
  "takes_hit": {
   "trigger": "Core event hit, target hob: the target barks. Also drop (Tumbled)",
   "anim": "hob_<id>_<side>_hit:flash",
   "chance": 0.4
  },
  "bonked": {
   "trigger": "Core event bonk, the target",
   "anim": "hob_<id>_<side>_bonked (frame 0)",
   "chance": 1.0
  },
  "win": {
   "trigger": "Core event win, the winning crew",
   "anim": "hob_<id>_<side>_cheer:jump",
   "chance": 1.0
  }
 },

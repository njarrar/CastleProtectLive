{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fort blueprints (rows top down, front facing right)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "rows"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8
        },
        "minItems": 3,
        "maxItems": 10
      }
    }
  }
}

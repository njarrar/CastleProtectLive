{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle setup (level_json for cp_new)",
  "type": "object",
  "required": [
    "level"
  ],
  "additionalProperties": false,
  "properties": {
    "level": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "campaign",
        "skirmish",
        "couch",
        "test_yard",
        "daily"
      ]
    },
    "sides": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control": {
            "enum": [
              "human",
              "ai"
            ]
          },
          "preset": {
            "enum": [
              "cozy",
              "fair",
              "stubborn"
            ]
          },
          "crew": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          },
          "blueprint": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doodads": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "kit": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "steam": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "aim": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "help": {
            "enum": [
              "none",
              "some",
              "lots"
            ],
            "description": "Help handicap: the side's Steam pool from content/app.json help_steam (some 120, lots 140). An explicit steam wins."
          },
          "preview_pct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Preview share of the arc for this side (Couch Duel handicap: 30, 45, 60 or 100)."
          },
          "crew_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Crew size handicap: seat only the first n Hobs."
          }
        }
      }
    },
    "first_turn": {
      "oneOf": [
        {
          "enum": [
            0,
            1
          ]
        },
        {
          "const": "coin"
        }
      ]
    },
    "round_cap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "squall": {
      "type": "boolean"
    },
    "wind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "fronts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "front_rounds": {
          "type": "integer"
        }
      }
    },
    "rummage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pool": {
          "type": "integer"
        },
        "picks": {
          "type": "integer"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "puff_up": {
      "type": "boolean"
    },
    "volley": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Volley Points: Actions per side (6, 10 or 14). Skirmish, Daily and Couch Duel only. No round cap, no Squall."
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the save holds for this level, for the Buttons reward in result.buttons.",
      "properties": {
        "cleared": {
          "type": "boolean"
        },
        "pennants": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "maxItems": 3
        },
        "daily_paid": {
          "type": "boolean"
        }
      }
    }
  }
}

              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "nook"
                },
                "id": {
                  "type": "integer"
                },
                "c": {
                  "type": "integer"
                },
                "r": {
                  "type": "integer"
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "intact": {
                  "type": "boolean"
                },
                "flap": {
                  "type": "boolean"
                },
                "lid": {
                  "type": "boolean"
                },
                "loophole": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          "kettle": {
            "type": "object",
            "required": [
              "hp",
              "max",
              "box",
              "room",
              "lid",
              "intact"
            ],
            "properties": {
              "hp": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "box": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "room": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "c": {
                "type": "integer"
              },
              "r": {
                "type": "integer"
              },
              "lid": {
                "type": "boolean"
              },
              "intact": {
                "type": "boolean"
              }
            }
          },
          "steam": {
            "type": "integer"
          },
          "steam_turn": {
            "type": "integer"
          },
          "shimmer": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "held": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "fatigue": {
            "type": "boolean"
          }
        }
      },
      "minItems": 2,
      "maxItems": 2
    },
    "hobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "side",
          "def",
          "name",
          "class",
          "hp",
          "max",
          "state",
          "x",
          "y",
          "rest",
          "knack_uses",
          "buried",
          "cover",
          "can_fire",
          "aim"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame snapshot (cp_snapshot output)",
  "type": "object",
  "required": [
    "tick",
    "phase",
    "side",
    "awaiting",
    "full",
    "terrain",
    "shells",
    "events"

              "cx",
              "cy",
              "x",
              "y",
              "w",
              "h",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "cx": {
                "type": "integer"
              },
              "cy": {
                "type": "integer"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "data": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "castles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "side",
          "x",
          "base_y",
          "cols",
          "rows",
          "block",
          "blocks",
          "rooms",
          "kettle",
          "steam",
          "steam_turn"

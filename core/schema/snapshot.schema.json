              },
              "cy": {
                "type": "integer"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "data": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "castles": {

                "kind": {
                  "const": "nook"
                },
                "id": {
                  "type": "integer"
                },
                "c": {
                  "type": "integer"
                },
                "r": {
                  "type": "integer"
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "integer"

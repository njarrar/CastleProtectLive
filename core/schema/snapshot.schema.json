          },
          "nook": {
            "type": [
              "integer",
              "null"
            ]
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "rest": {
            "type": "integer"
          },
          "knack": {
            "type": [
              "string",
              "null"
            ]
          },
          "knack_uses": {
            "type": "integer"
          },
          "plain": {
            "type": "string"
          },
          "buried": {
            "type": "boolean"
          },
          "cover": {
            "type": "boolean"
          },
          "dummy": {
            "type": "boolean"
          },
          "grudge": {
            "type": "boolean"
          },
          "clatter": {
            "type": "boolean"
          },
          "can_fire": {
            "type": "boolean"
          },
          "aim": {
            "description": "Live aim, only for the side on turn; null for the other side.",

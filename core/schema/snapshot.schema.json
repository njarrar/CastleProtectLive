        "side": {
          "type": "integer"
        },
        "wind": {
          "type": "integer"
        },
        "forecast": {
          "type": "integer"
        },
        "front_rounds_left": {
          "type": "integer"
        },
        "steam": {
          "type": "array",
          "items": {
            "type": "integer"

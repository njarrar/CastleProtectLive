              "hp": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "box": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "room": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "c": {
                "type": "integer"
              },
              "r": {
                "type": "integer"
              },
              "lid": {
                "type": "boolean"
              },
              "intact": {
                "type": "boolean"
              }

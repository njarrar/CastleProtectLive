    "shells": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 5,
        "maxItems": 5
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "side",
          "kind",
          "x",
          "y",
          "hp",
          "max"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "side": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "hp": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "shot": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "preview": {
      "type": "array",
      "items": {
        "type": "array",

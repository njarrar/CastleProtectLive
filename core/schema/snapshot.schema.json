        "properties": {
          "side": {
            "type": "integer"
          },
          "x": {
            "type": "integer"
          },
          "base_y": {
            "type": "integer"
          },
          "cols": {
            "type": "integer"
          },
          "rows": {
            "type": "integer"
          },
          "block": {
            "type": "integer"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "c",
                "r",
                "x",
                "y",
                "mat",
                "hp",
                "max"
              ],
              "additionalProperties": false,
              "properties": {
                "c": {
                  "type": "integer"
                },
                "r": {
                  "type": "integer"
                },
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                },
                "mat": {
                  "type": "string"
                },
                "hp": {
                  "type": "integer"
                },
                "max": {
                  "type": "integer"
                },
                "peephole": {
                  "type": "boolean"
                },
                "root": {
                  "type": "boolean"
                },
                "battered": {
                  "type": "boolean"
                }

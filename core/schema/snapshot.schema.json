{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame snapshot (cp_snapshot output)",
  "type": "object",
  "required": [
    "tick",
    "phase",
    "side",
    "awaiting",
    "full",
    "terrain",
    "shells",
    "events"
  ],
  "properties": {
    "tick": {
      "type": "integer"
    },
    "phase": {
      "enum": [
        "draft",
        "plan",
        "resolve",
        "settle",
        "ended"
      ]
    },
    "side": {
      "type": "integer"
    },
    "awaiting": {
      "enum": [
        "human",
        "ai",
        "none"
      ]
    },
    "full": {
      "type": "boolean"
    },
    "level": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "w",
        "h",
        "chunk"
      ],
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "chunk": {
          "const": 64
        }
      }
    },
    "terrain": {
      "type": "object",
      "required": [
        "chunks"
      ],

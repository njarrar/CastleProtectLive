    "ghosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "side",
          "hob",
          "shot",
          "angle",
          "power",
          "round",
          "pin",
          "points"
        ],
        "properties": {
          "index": {
            "type": "integer"

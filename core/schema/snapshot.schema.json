      "type": "integer"
    },
    "phase": {
      "enum": [
        "draft",
        "plan",
        "resolve",
        "settle",
        "ended"
      ]
    },
    "side": {
      "type": "integer"
    },
    "awaiting": {
      "enum": [
        "human",
        "ai",
        "none"
      ]
    },
    "full": {
      "type": "boolean"
    },
    "level": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "w",
        "h",
        "chunk"
      ],
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "chunk": {
          "type": "integer"
        }
      }
    },
    "terrain": {

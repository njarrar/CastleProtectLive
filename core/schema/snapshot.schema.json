            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "hp": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "state": {
            "enum": [
              "seated",
              "open",
              "dropped",
              "tumbled",
              "squashed",
              "bonked"

              "round_start",
              "turn_start",
              "front",
              "squall_warning",
              "squall_round",
              "squall",
              "fire",
              "walk",
              "shove_off",
              "split",
              "explode",
              "carve",
              "mound",
              "hit",
              "break",
              "collapse",
              "big_drop",
              "drop",
              "climb",
              "bonk",
              "threaded",
              "kettle_pop",
              "castle_drop",
              "thump",
              "buried",
              "dug_out",
              "lid",
              "lid_block",
              "mend",
              "rebuild",
              "puff_up",
              "prop",
              "prop_wake",

          "hob": {
            "type": "integer"
          },
          "shot": {
            "type": "string"
          },
          "angle": {
            "type": "integer"
          },
          "power": {
            "type": "integer"
          },
          "round": {
            "type": "integer"
          },
          "pin": {
            "oneOf": [
              {
                "type": "array",

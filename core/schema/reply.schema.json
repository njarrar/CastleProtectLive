{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command reply (cp_command output)",
  "oneOf": [
    {
      "$ref": "#/$defs/reply"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reply"
      }
    }
  ],
  "$defs": {
    "reply": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "can_fire": {
          "type": "boolean"
        },
        "angle": {
          "type": "integer"
        },
        "power": {
          "type": "integer"
        },
        "moved": {
          "type": "integer"
        },
        "steam": {
          "type": "integer"
        },
        "commands": {
          "type": "array"
        },
        "results": {
          "type": "array"
        },
        "falls": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "side": {
          "type": "integer"
        },
        "hash": {
          "type": "string"
        },
        "log": {
          "type": "array"
        },
        "cost": {
          "type": "integer"
        },
        "used": {
          "type": "integer"
        },
        "budget": {
          "type": "integer"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "applied": {
          "type": "integer"
        },
        "index": {
          "type": "integer"
        },
        "shot": {
          "type": "string"
        },
        "hob": {
          "type": "integer"
        },
        "ready": {
          "type": "boolean"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "ready_shot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
